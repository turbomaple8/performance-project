# Copy this block into Streamlit Community Cloud → App → Settings → Secrets.
# Fill the values from config/service-account.json (NEVER commit the real key).
# Locally you don't need this file; the app falls back to config/service-account.json.

# Firebase refresh token for the team edge app (hh-fllat-edge) — powers the Rent
# Arrears section. Obtain it once from a logged-in browser session and paste here.
# Long-lived but revocable. Locally the app falls back to
# runs/hh-edge/refresh_token.txt (gitignored).
edge_refresh_token = "PASTE_FIREBASE_REFRESH_TOKEN"

[gcp_service_account]
type = "service_account"
project_id = "performance-pipeline-495618"
private_key_id = "YOUR_PRIVATE_KEY_ID"
# Keep the literal \n sequences inside the quotes.
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY_LINES\n-----END PRIVATE KEY-----\n"
client_email = "perf-pipeline-reader@performance-pipeline-495618.iam.gserviceaccount.com"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "YOUR_CERT_URL"
universe_domain = "googleapis.com"
